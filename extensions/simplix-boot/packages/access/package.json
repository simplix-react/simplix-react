    "@casl/ability": "catalog:",
    "@simplix-react/access": "workspace:*",
    "@simplix-react/api": "workspace:*",
    "@simplix-react/config-typescript": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
