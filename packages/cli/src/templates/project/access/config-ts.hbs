{{#if enableAuth}}
import type { AccessPolicy, DefaultActions } from "@simplix-react/access";
import { createSelfAccessPolicy } from "@simplix-react-ext/simplix-boot-access";
import { auth } from "../auth/index.js";

// Who is signed in and what they are granted, in one read through the auth stack's own fetch.
// The self policy carries the user across; a policy without one leaves every route guard waiting.
export const accessPolicy: AccessPolicy<DefaultActions> = createSelfAccessPolicy({
  endpoint: "/api/v1/user/me/permissions",
  fetchFn: auth.fetchFn,
});
{{else}}
import { createAccessPolicy, createApiAdapter } from "@simplix-react/access";

export const accessPolicy = createAccessPolicy({
  adapter: createApiAdapter({
    endpoint: "/api/v1/user/me/permissions",
  }),
  publicAccess: createApiAdapter({
    endpoint: "/api/v1/public/user/permissions",
  }),
  isSuperAdmin: (user) => user.isSuperAdmin === true,
  persist: {
    key: "{{kebabCase projectName}}-access",
    revalidateOnMount: true,
  },
});
{{/if}}
