{
  "name": "@simplix-react-ext/simplix-boot-access",
  "version": "0.3.12-SNAPSHOT",
  "description": "Spring Security authorization for @simplix-react/access: the permissions adapter and the self access policy",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
